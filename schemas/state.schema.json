{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nmapaye/panoptes/schemas/state.schema.json",
  "title": "Panoptes AWS State Snapshot",
  "type": "object",
  "required": ["schema_version", "provider", "org_id", "timestamp", "accounts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "provider": {
      "type": "string",
      "const": "aws"
    },
    "org_id": {
      "type": "string",
      "pattern": "^o-[a-z0-9]{10,32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "account": {
      "type": "object",
      "required": ["id", "name", "roles"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{12}$"
        },
        "name": {
          "type": "string"
        },
        "principals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/principal"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": ["id", "name", "arn"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arn": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "arn", "trusted_principals", "trust"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arn": {
          "type": "string"
        },
        "admin": {
          "type": "boolean"
        },
        "trusted_principals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "wildcard_principal": {
          "type": "boolean"
        },
        "allowed_org_id": {
          "type": "string",
          "pattern": "^o-[a-z0-9]{10,32}$"
        },
        "require_mfa": {
          "type": "boolean"
        },
        "external_id": {
          "type": "string"
        },
        "source_identity": {
          "type": "string"
        },
        "principal_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "resource_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source_vpces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ip_cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
